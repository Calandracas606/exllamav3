    TORCH_CHECK_SHAPES(b, 1, c, -1, 1);
    TORCH_CHECK(c.stride(-1) == 1, "c must have contiguous columns");

    const half* a_ptr = (const half*) a.data_ptr();
    const half* b_ptr = (const half*) b.data_ptr();

    int size_k = a.size(-1);
    int size_m = a.numel() / size_k;
    int size_n = b.size(-1);
    int64_t c_stride_m = c.stride(-2);
    TORCH_CHECK(c_stride_m >= size_n, "c row stride is too small");
    TORCH_CHECK(c_stride_m <= std::numeric_limits<int>::max(), "c row stride is too large");

    // Set cuBLAS modes and workspace
    hipblasHandle_t cublas_handle = at::cuda::getCurrentCUDABlasHandle();
    hipblasSetStream(cublas_handle, stream);
    hipblasSetPointerMode(cublas_handle, HIPBLAS_POINTER_MODE_HOST);
    int device;
    hipGetDevice(&device);
    void* ws = DevCtx::instance().get_ws(device);
    hipblasSetWorkspace(cublas_handle, ws, WORKSPACE_SIZE);

    float alpha_ = 1.0f;
    float beta_ = 0.0f;
    hipDataType c_type = output_fp32 ? HIP_R_32F : HIP_R_16F;
    auto r = hipblasGemmEx
    (
        cublas_handle,
        HIPBLAS_OP_N, HIPBLAS_OP_N,
        size_n, size_m, size_k,
        &alpha_, b_ptr, HIP_R_16F, size_n,
                 a_ptr, HIP_R_16F, size_k,
        &beta_,  c.data_ptr(), c_type, (int) c_stride_m,
        HIPBLAS_COMPUTE_32F,
        HIPBLAS_GEMM_DEFAULT
